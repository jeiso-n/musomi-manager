<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.musomi.desktop.controller.DashboardController"
            style="-fx-background-color: #f7f8fc;">

    <center>
        <VBox spacing="22" fillWidth="true">
            <padding>
                <Insets top="28" right="30" bottom="28" left="30"/>
            </padding>

            <!-- ADMINISTRATOR DASHBOARD -->
            <VBox fx:id="adminDashboard" spacing="22">

                <VBox spacing="5">
                    <Label text="Dashboard"
                           styleClass="page-title"/>
                    <Label text="Welcome back, Administrator"
                           styleClass="page-subtitle"/>
                </VBox>

                <HBox spacing="18">
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          styleClass="dashboard-card">
                        <Label text="ST" styleClass="stat-icon stat-icon-students"/>
                        <Label text="Students" styleClass="card-title"/>
                        <Label text="0" styleClass="card-value"/>
                        <Label text="Total students" styleClass="card-description"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          styleClass="dashboard-card">
                        <Label text="CL" styleClass="stat-icon stat-icon-classes"/>
                        <Label text="Classes" styleClass="card-title"/>
                        <Label text="0" styleClass="card-value"/>
                        <Label text="Active classes" styleClass="card-description"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          styleClass="dashboard-card">
                        <Label text="SB" styleClass="stat-icon stat-icon-subjects"/>
                        <Label text="Subjects" styleClass="card-title"/>
                        <Label text="0" styleClass="card-value"/>
                        <Label text="Available subjects" styleClass="card-description"/>
                    </VBox>

                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          styleClass="dashboard-card">
                        <Label text="US" styleClass="stat-icon stat-icon-users"/>
                        <Label text="Users" styleClass="card-title"/>
                        <Label text="0" styleClass="card-value"/>
                        <Label text="System users" styleClass="card-description"/>
                    </VBox>
                </HBox>

                <HBox spacing="18" VBox.vgrow="ALWAYS">
                    <VBox spacing="16" HBox.hgrow="ALWAYS"
                          styleClass="dashboard-section">
                        <Label text="Recent Activity" styleClass="section-title"/>
                        <Separator/>
                        <Label text="No recent activity"
                               styleClass="activity-description"/>
                        <Label text="Activity will appear here when users perform actions."
                               wrapText="true"
                               styleClass="activity-description"/>
                    </VBox>

                    <VBox spacing="16" prefWidth="280"
                          styleClass="dashboard-section">
                        <Label text="Quick Actions" styleClass="section-title"/>

                        <Button text="+  Add Student"
                                maxWidth="Infinity"
                                styleClass="dashboard-action-button"
                                onAction="#handleAddStudent"/>

                        <Button text="+  Add Class"
                                maxWidth="Infinity"
                                styleClass="dashboard-action-button"
                                onAction="#handleAddClass"/>

                        <Button text="+  Add Subject"
                                maxWidth="Infinity"
                                styleClass="dashboard-action-button"
                                onAction="#handleAddSubject"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- TEACHER DASHBOARD -->
            <VBox fx:id="teacherDashboard" spacing="22">

                <VBox spacing="5">
                    <Label fx:id="greetingLabel"
                           text="Welcome back"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <Label text="Here's what's happening at your school today."
                           styleClass="page-subtitle"/>
                </VBox>

                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <javafx.scene.layout.ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <javafx.scene.layout.ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <javafx.scene.layout.ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <javafx.scene.layout.ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" spacing="7"
                          style="-fx-background-color: #eef5ff; -fx-background-radius: 12; -fx-padding: 18;">
                        <Label text="MY CLASSES"/>
                        <Label fx:id="myClassesCount" text="0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="Classes assigned"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1" spacing="7"
                          style="-fx-background-color: #eefbf4; -fx-background-radius: 12; -fx-padding: 18;">
                        <Label text="TOTAL STUDENTS"/>
                        <Label fx:id="totalStudentsCount" text="0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="Students in your classes"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2" spacing="7"
                          style="-fx-background-color: #fff5e9; -fx-background-radius: 12; -fx-padding: 18;">
                        <Label text="PENDING MARKS"/>
                        <Label fx:id="pendingMarksCount" text="0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="Need attention"/>
                    </VBox>

                    <VBox GridPane.columnIndex="3" spacing="7"
                          style="-fx-background-color: #f4efff; -fx-background-radius: 12; -fx-padding: 18;">
                        <Label text="PUBLISHED ASSESSMENTS"/>
                        <Label fx:id="publishedAssessmentsCount" text="0"
                               style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="This term"/>
                    </VBox>
                </GridPane>

                <HBox spacing="18" VBox.vgrow="ALWAYS">
                    <VBox spacing="12" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                        <Label text="Recent Activity" styleClass="section-title"/>
                        <Separator/>
                        <Label text="Assessment and mark-entry activity will appear here."
                               wrapText="true"
                               styleClass="activity-description"/>
                    </VBox>

                    <VBox spacing="12" prefWidth="300"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                        <Label text="Class Performance" styleClass="section-title"/>
                        <Separator/>
                        <Label text="S3 Blue — 82%"/>
                        <ProgressBar progress="0.82" maxWidth="Infinity"/>
                        <Label text="S3 Red — 76%"/>
                        <ProgressBar progress="0.76" maxWidth="Infinity"/>
                        <Label text="S4 Blue — 71%"/>
                        <ProgressBar progress="0.71" maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER_LEFT"
                      style="-fx-background-color: #f4efff; -fx-background-radius: 12; -fx-padding: 16 20;">
                    <VBox spacing="3">
                        <Label text="Mark Entry Reminder"
                               style="-fx-font-weight: bold; -fx-text-fill: #4c1d95;"/>
                        <Label fx:id="pendingReminderText"
                               text="Checking pending assessments..."
                               wrapText="true"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="markEntryButton"
                            text="Go to Mark Entry"
                            onAction="#goToMarkEntry"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
