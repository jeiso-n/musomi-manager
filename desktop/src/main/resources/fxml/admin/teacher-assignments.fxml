<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.musomi.desktop.controller.admin.TeacherAssignmentController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="page-scroll">

    <content>
        <VBox spacing="18"
              fillWidth="true"
              styleClass="page-container">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <!-- Page heading and statistics -->
            <VBox spacing="10">
                <VBox spacing="6">
                    <Label text="Teacher Assignments"
                           styleClass="page-title"/>
                    <Label text="Assign teachers to classes and subjects"
                           styleClass="page-subtitle"/>
                </VBox>

                <HBox spacing="16">
                    <VBox spacing="8"
                          styleClass="table-card"
                          HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="18" right="20" bottom="18" left="20"/>
                        </padding>
                        <Label text="Total Assignments" styleClass="form-label"/>
                        <Label fx:id="totalAssignmentsLabel"
                               text="0"
                               styleClass="section-title"/>
                    </VBox>

                    <VBox spacing="8"
                          styleClass="table-card"
                          HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets top="18" right="20" bottom="18" left="20"/>
                        </padding>
                        <Label text="Assigned Teachers" styleClass="form-label"/>
                        <Label fx:id="assignedTeachersLabel"
                               text="0"
                               styleClass="section-title"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Assignment form -->
            <VBox spacing="16" styleClass="table-card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <Label text="Create Assignment" styleClass="section-title"/>

                <HBox spacing="14">
                    <VBox spacing="7">
                        <HBox spacing="4">
                            <Label text="Teacher" styleClass="form-label"/>
                            <Label text="*" style="-fx-text-fill: #DC2626;"/>
                        </HBox>
                        <ComboBox fx:id="teacherComboBox"
                                  promptText="Select teacher"
                                  prefWidth="190"
                                  maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="Class" styleClass="form-label"/>
                        <ComboBox fx:id="classComboBox"
                                  promptText="Select class"
                                  prefWidth="170"
                                  maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="Subject" styleClass="form-label"/>
                        <ComboBox fx:id="subjectComboBox"
                                  promptText="Select subject"
                                  prefWidth="190"
                                  maxWidth="Infinity"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="messageLabel"
                           text="Select a teacher, class and subject."
                           styleClass="text-muted"
                           wrapText="true"
                           HBox.hgrow="ALWAYS"/>
                    <Button text="Clear"
                            styleClass="secondary-button"
                            onAction="#clearForm"/>
                    <Button text="Assign Teacher"
                            styleClass="primary-button"
                            onAction="#assignTeacher"/>
                </HBox>
            </VBox>

            <!-- Current assignments: table has its own vertical scrollbar. -->
            <VBox spacing="12" styleClass="table-card">
                <padding>
                    <Insets top="18" right="20" bottom="20" left="20"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Current Assignments" styleClass="section-title"/>
                    <VBox HBox.hgrow="ALWAYS"/>
                    <Button text="Refresh"
                            styleClass="secondary-button"
                            onAction="#refreshAssignments"/>
                    <Button text="Remove Assignment"
                            styleClass="secondary-button"
                            onAction="#removeAssignment"/>
                </HBox>

                <TableView fx:id="assignmentsTable"
                           styleClass="modern-table"
                           prefHeight="340"
                           minHeight="240"
                           maxHeight="520">
                    <placeholder>
                        <Label text="No assignments yet. Create an assignment above."
                               styleClass="text-muted"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="teacherColumn"
                                     text="Teacher"
                                     prefWidth="200"/>
                        <TableColumn fx:id="classColumn"
                                     text="Class"
                                     prefWidth="160"/>
                        <TableColumn fx:id="subjectColumn"
                                     text="Subject"
                                     prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
