<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    login.fxml — Musomi Manager login screen
    Layout: 55/45 columns (indigo brand panel | white form panel)
    Controller: com.musomi.desktop.controller.LoginController
    Stylesheets: applied globally by SceneManager (styles.css + components.css)
-->
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musomi.desktop.controller.LoginController"
      prefWidth="1280"
      prefHeight="720">

    <!-- ===================================================================
         LEFT PANEL — Indigo branding column
         =================================================================== -->
    <VBox fx:id="leftPanel"
          styleClass="login-left-panel"
          prefWidth="704"
          HBox.hgrow="ALWAYS">

        <!-- Top: logo placeholder + app name + optional school name -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="40" left="40" right="40" bottom="0"/></padding>
            <Label text="M"
                   styleClass="logo-placeholder text-white"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"
                   alignment="CENTER"/>
            <Label text="Musomi Manager" styleClass="logo-text"/>
            <Label fx:id="schoolNameLabel" styleClass="body-small text-white-subtle"/>
        </HBox>

        <!-- Flexible spacer — pushes branding copy toward center -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Center: headline + sub-heading -->
        <VBox spacing="16">
            <padding><Insets left="64" right="64" bottom="60"/></padding>
            <Label text="Better Education Management"
                   styleClass="display-white"
                   wrapText="true"/>
            <Label text="Track performance. Empower teachers. Support every student."
                   styleClass="body-small text-white-subtle"
                   wrapText="true"/>
        </VBox>

    </VBox>

    <!-- ===================================================================
         RIGHT PANEL — White login form column
         =================================================================== -->
    <VBox fx:id="rightPanel"
          styleClass="login-right-panel"
          prefWidth="576"
          HBox.hgrow="ALWAYS"
          alignment="CENTER"
          spacing="0">

        <!-- Flexible top spacer — vertically centers the card -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Card wrapper: centers card horizontally, constrains max width -->
        <StackPane alignment="CENTER" maxWidth="380" minWidth="380">
            <padding><Insets top="0" right="40" bottom="0" left="40"/></padding>

            <!-- Login card — styleClass must remain card login-card -->
            <VBox styleClass="card login-card" spacing="24">

                <!-- Heading block -->
                <VBox spacing="6">
                    <Label text="Welcome back" styleClass="h1"/>
                    <Label text="Sign in to your Musomi Manager account"
                           styleClass="body-small"
                           wrapText="true"/>
                </VBox>

                <!-- Username field -->
                <VBox spacing="8">
                    <Label text="Username or Email" styleClass="form-label"/>
                    <StackPane alignment="CENTER_LEFT">
                        <TextField fx:id="usernameField"
                                   styleClass="input"
                                   promptText="Enter your username or email"
                                   onAction="#handleLogin"
                                   style="-fx-padding: 0 12 0 36;"/>
                        <Label text="👤"
                               mouseTransparent="true"
                               style="-fx-font-size: 14px;
                                      -fx-text-fill: #94a3b8;
                                      -fx-padding: 0 0 0 12;"/>
                    </StackPane>
                </VBox>

                <!-- Password field -->
                <VBox spacing="8">
                    <Label text="Password" styleClass="form-label"/>
                    <StackPane alignment="CENTER_LEFT">
                        <PasswordField fx:id="passwordField"
                                       styleClass="input"
                                       promptText="Enter your password"
                                       onAction="#handleLogin"
                                       style="-fx-padding: 0 40 0 12;"/>
                        <TextField fx:id="visiblePasswordField"
                                   styleClass="input"
                                   promptText="Enter your password"
                                   onAction="#handleLogin"
                                   visible="false"
                                   managed="false"
                                   style="-fx-padding: 0 40 0 12;"/>
                        <Button fx:id="togglePasswordButton"
                                text="👁"
                                onAction="#togglePasswordVisibility"
                                StackPane.alignment="CENTER_RIGHT"
                                style="-fx-background-color: transparent;
                                       -fx-cursor: hand;
                                       -fx-font-size: 14px;
                                       -fx-text-fill: #64748b;
                                       -fx-padding: 4 10 4 10;"/>
                    </StackPane>
                </VBox>

                <!-- Error label — hidden and collapsed by default -->
                <Label fx:id="errorLabel"
                       styleClass="error-label"
                       wrapText="true"
                       visible="false"
                       managed="false"/>

                <!-- Sign In button with overlay spinner -->
                <StackPane>
                    <VBox.margin>
                        <Insets top="8"/>
                    </VBox.margin>
                    <Button fx:id="loginButton"
                            text="Sign In"
                            styleClass="btn-primary"
                            maxWidth="Infinity"
                            defaultButton="true"
                            onAction="#handleLogin"/>
                    <ProgressIndicator fx:id="spinner"
                                       maxWidth="22"
                                       maxHeight="22"
                                       visible="false"
                                       managed="false"/>
                </StackPane>

            </VBox>
        </StackPane>

        <!-- Flexible bottom spacer — pushes version label to bottom -->
        <Region VBox.vgrow="ALWAYS"/>

        <!-- Version label — sits at bottom of right panel, outside the card -->
        <Label fx:id="versionLabel"
               styleClass="text-muted"
               maxWidth="Infinity"
               alignment="CENTER">
            <VBox.margin>
                <Insets bottom="24"/>
            </VBox.margin>
        </Label>

    </VBox>

</HBox>