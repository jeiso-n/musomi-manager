<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.musomi.desktop.controller.teacher.ClassRosterController"
             styleClass="fxml-inline-023">

    <!-- ===================================================== -->
    <!-- PAGE HEADER                                           -->
    <!-- ===================================================== -->

    <top>

        <VBox spacing="5.0">

            <padding>
                <Insets top="26.0" right="30.0" bottom="18.0" left="30.0"/>
            </padding>

            <!-- Back button + class name row -->
            <HBox spacing="12.0" alignment="CENTER_LEFT">

                <Button text="← Back to My Classes"
                        onAction="#handleBack"
                         styleClass="fxml-inline-045"/>

            </HBox>

            <Label fx:id="classNameLabel"
                   text="Class Roster"
                    styleClass="fxml-inline-024"/>

            <Label fx:id="studentCountLabel"
                   text="0 students"
                    styleClass="fxml-inline-025"/>

        </VBox>

    </top>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT                                          -->
    <!-- ===================================================== -->

    <center>

        <VBox spacing="16.0">

            <padding>
                <Insets top="0.0" right="30.0" bottom="25.0" left="30.0"/>
            </padding>


            <!-- ============================================= -->
            <!-- SEARCH TOOLBAR                                -->
            <!-- ============================================= -->

            <HBox spacing="12.0" alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Search student name or admission number..."
                           prefWidth="380.0"
                            styleClass="fxml-inline-046"/>

                <Region HBox.hgrow="ALWAYS"/>

            </HBox>


            <!-- ============================================= -->
            <!-- STUDENT TABLE                                 -->
            <!-- ============================================= -->

            <TableView fx:id="rosterTable"
                       VBox.vgrow="ALWAYS"
                        styleClass="fxml-inline-047">

                <columns>

                    <TableColumn fx:id="numberColumn"
                                 text="#"
                                 prefWidth="55.0"/>

                    <TableColumn fx:id="admNoColumn"
                                 text="Admission Number"
                                 prefWidth="180.0"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Student Name"
                                 prefWidth="250.0"/>

                    <TableColumn fx:id="genderColumn"
                                 text="Gender"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120.0"/>

                </columns>

            </TableView>


            <!-- ============================================= -->
            <!-- EMPTY STATE                                   -->
            <!-- ============================================= -->

            <VBox fx:id="emptyState"
                  alignment="CENTER"
                  spacing="10.0"
                  prefHeight="200.0"
                  visible="false"
                  managed="false"
                   styleClass="fxml-inline-047">

                <padding>
                    <Insets top="40.0" bottom="40.0"/>
                </padding>

                <Label text="No students found"
                        styleClass="fxml-inline-048"/>

                <Label text="Try a different name or admission number."
                        styleClass="fxml-inline-009"/>

            </VBox>


            <!-- ============================================= -->
            <!-- STATUS BAR                                    -->
            <!-- ============================================= -->

            <Separator/>

        </VBox>

    </center>

</BorderPane>
