<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.musomi.desktop.controller.teacher.MarkEntryController"
styleClass="mark-entry">

    <!-- ========================================================= -->
    <!-- PAGE HEADER                                                -->
    <!-- ========================================================= -->

    <top>

        <VBox spacing="5.0">

            <padding>
                <Insets top="26.0"
                        right="30.0"
                        bottom="18.0"
                        left="30.0"/>
            </padding>

            <Label text="Mark Entry"
                    styleClass="fxml-inline-024"/>

            <Label text="Enter and manage student marks for your classes."
                    styleClass="fxml-inline-025"/>

        </VBox>

    </top>


    <!-- ========================================================= -->
    <!-- MAIN CONTENT                                               -->
    <!-- ========================================================= -->

    <center>

        <VBox spacing="16.0">

            <padding>
                <Insets top="0.0"
                        right="30.0"
                        bottom="25.0"
                        left="30.0"/>
            </padding>


            <!-- ================================================= -->
            <!-- FILTER CARD                                        -->
            <!-- ================================================= -->

            <VBox spacing="12.0"
                   styleClass="fxml-inline-049">

                <GridPane hgap="14.0"
                          vgap="8.0">

                    <!-- CLASS -->

                    <Label text="Class"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"
                            styleClass="fxml-inline-050"/>

                    <ComboBox fx:id="classComboBox"
                              prefWidth="180.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1"/>


                    <!-- SUBJECT -->

                    <Label text="Subject"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"
                            styleClass="fxml-inline-050"/>

                    <ComboBox fx:id="subjectComboBox"
                              prefWidth="180.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1"/>


                    <!-- TOPIC -->

                    <Label text="Topic"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0"
                            styleClass="fxml-inline-050"/>

                    <ComboBox fx:id="topicComboBox"
                              prefWidth="180.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="2"
                              GridPane.rowIndex="1"/>


                    <!-- ASSESSMENT -->

                    <Label text="Assessment"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"
                            styleClass="fxml-inline-050"/>

                    <ComboBox fx:id="assessmentComboBox"
                              prefWidth="180.0"
                              maxWidth="Infinity"
                              GridPane.columnIndex="3"
                              GridPane.rowIndex="1"/>

                </GridPane>

            </VBox>


            <!-- ================================================= -->
            <!-- TABLE TOOLBAR                                      -->
            <!-- ================================================= -->

            <HBox spacing="12.0"
                  alignment="CENTER_LEFT">

                <Label text="Student Marks"
                        styleClass="fxml-inline-048"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="saveAllButton"
                        text="Save All"
                        onAction="#saveAll"
                         styleClass="fxml-inline-051"/>

            </HBox>


            <!-- ================================================= -->
            <!-- SEARCH                                             -->
            <!-- ================================================= -->

            <HBox spacing="10.0"
                  alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Search student name..."
                           prefWidth="320.0"
                            styleClass="fxml-inline-046"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Saved"
                        styleClass="fxml-inline-052"/>

                <Label text="Modified"
                        styleClass="fxml-inline-053"/>

                <Label text="Invalid"
                        styleClass="fxml-inline-054"/>

            </HBox>


            <!-- ================================================= -->
            <!-- MARK TABLE                                        -->
            <!-- ================================================= -->

            <TableView fx:id="marksTable"
                       editable="true"
                       VBox.vgrow="ALWAYS"
                        styleClass="fxml-inline-047">

                <columns>

                    <TableColumn fx:id="numberColumn"
                                 text="#"
                                 prefWidth="55.0"/>

                    <TableColumn fx:id="studentColumn"
                                 text="Student Name"
                                 prefWidth="250.0"/>

                    <TableColumn fx:id="markColumn"
                                 text="Mark"
                                 prefWidth="120.0"
                                 editable="true"/>

                    <TableColumn fx:id="totalColumn"
                                 text="Total"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="gradeColumn"
                                 text="Grade"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="remarkColumn"
                                 text="Remarks"
                                 prefWidth="240.0"/>

                </columns>

            </TableView>


            <!-- ================================================= -->
            <!-- STATUS                                             -->
            <!-- ================================================= -->

            <Separator/>

            <HBox alignment="CENTER_LEFT" spacing="12.0">

                <Label fx:id="progressLabel"
                       text="0 / 0 students marked"
                        styleClass="fxml-inline-055"/>

                <ProgressBar fx:id="progressBar"
                             progress="0.0"
                             prefWidth="140.0"
                             maxWidth="140.0"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="statusLabel"
                       text="Select an assessment to enter marks."
                        styleClass="fxml-inline-055"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>
