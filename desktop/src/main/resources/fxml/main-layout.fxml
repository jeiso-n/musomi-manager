<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.musomi.desktop.controller.MainLayoutController"
            prefWidth="1280.0"
            prefHeight="720.0">

    <top>
        <HBox spacing="20.0"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="MM" styleClass="logo-mark"/>
                <VBox spacing="0.0">
                    <Label text="Musomi" styleClass="brand-name"/>
                    <Label text="Manager" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="globalSearchField"
                       promptText="Search anything..."
                       prefWidth="280.0"
                       styleClass="search-field"/>

            <Button text="●" styleClass="notification-button"/>

            <HBox spacing="12.0"
                  alignment="CENTER_LEFT"
                  styleClass="user-profile">
                <Label text="A" styleClass="avatar"/>
                <VBox spacing="2.0" alignment="CENTER_LEFT">
                    <Label text="Administrator" styleClass="user-name"/>
                    <Label text="System Administrator" styleClass="user-role"/>
                </VBox>
                <Button text="Logout"
                        onAction="#handleLogout"
                        styleClass="logout-button"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="240.0"
              spacing="8.0"
              styleClass="sidebar">

            <Label text="NAVIGATION" styleClass="sidebar-title"/>

            <Button text="Dashboard"
                    maxWidth="Infinity"
                    styleClass="nav-button-active"
                    onAction="#showDashboard"/>

            <!-- Admin-only navigation -->
            <VBox fx:id="adminNavSection" spacing="8.0">
                <Label text="ADMIN" styleClass="sidebar-title"/>

                <Button text="Users" maxWidth="Infinity"
                        onAction="#showUsers"/>
                <Button text="Classes" maxWidth="Infinity"
                        onAction="#showClasses"/>
                <Button text="Subjects" maxWidth="Infinity"
                        onAction="#showSubjects"/>
                <Button text="Topics" maxWidth="Infinity"
                        onAction="#showTopics"/>
                <Button text="Students" maxWidth="Infinity"
                        onAction="#showStudents"/>

                <Region prefHeight="15.0"/>

                <Label text="SYSTEM" styleClass="sidebar-title"/>

                <Button text="Settings" maxWidth="Infinity"
                        onAction="#showSettings"/>
                <Button text="Audit Log" maxWidth="Infinity"
                        onAction="#showAuditLog"/>
            </VBox>

            <!-- Teacher-only navigation -->
            <VBox fx:id="teacherNavSection" spacing="8.0">
                <Label text="TEACHER" styleClass="sidebar-title"/>

                <Button text="My Classes" maxWidth="Infinity"
                        onAction="#showMyClasses"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="10.0"
                  alignment="CENTER_LEFT"
                  styleClass="sidebar-user">
                <Label text="A" styleClass="sidebar-avatar"/>
                <VBox spacing="2.0">
                    <Label text="Administrator"
                           styleClass="sidebar-user-name"/>
                    <Label text="System Administrator"
                           styleClass="sidebar-user-role"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"
                   styleClass="content-area"/>
    </center>

</BorderPane>
