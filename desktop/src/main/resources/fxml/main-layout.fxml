<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.musomi.desktop.controller.MainLayoutController"
            styleClass="app-root">

    <!-- TOP BAR -->
    <top>
        <HBox prefHeight="64.0"
              alignment="CENTER_LEFT"
              spacing="20"
              styleClass="top-bar">

            <padding>
                <Insets left="24" right="24"/>
            </padding>

            <Label text="MUSOMI MANAGER"
                   styleClass="brand-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- GLOBAL SEARCH -->
            <TextField fx:id="globalSearchField"
                       promptText="Search students, subjects, topics..."
                       prefWidth="340"
                       maxWidth="340"
                       styleClass="global-search"/>

            <Region prefWidth="12"/>

            <!-- CURRENT USER -->
            <Label fx:id="roleLabel"
                   text="Admin"
                   styleClass="topbar-role"/>

            <Label fx:id="userNameLabel"
                   text="System Administrator"
                   styleClass="topbar-username"/>

            <Label fx:id="topbarInitialsLabel"
                   text="SA"
                   styleClass="avatar-circle"/>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="240"
              spacing="8"
              styleClass="sidebar">

            <padding>
                <Insets top="16" right="14" bottom="12" left="14"/>
            </padding>

            <!-- Scrollable branding and navigation; profile remains anchored below. -->
            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        pannable="true"
                        VBox.vgrow="ALWAYS"
                        styleClass="sidebar-nav-scroll">
                <content>
                    <VBox spacing="8">
                        

                        <Label fx:id="sectionRoleLabel"
                               text="ADMIN"
                               styleClass="sidebar-title"/>

                        <VBox fx:id="teacherNavSection"
                              spacing="4">
                            <Button fx:id="dashboardButton"
                                    text="Dashboard"
                                    maxWidth="Infinity"
                                    onAction="#showDashboard"
                                    styleClass="nav-button"/>
                            <Button fx:id="markEntryButton"
                                    text="Mark Entry"
                                    maxWidth="Infinity"
                                    onAction="#showMarkEntry"
                                    styleClass="nav-button"/>
                            <Button fx:id="myClassesButton"
                                    text="My Classes"
                                    maxWidth="Infinity"
                                    onAction="#showMyClasses"
                                    styleClass="nav-button"/>
                            <Button fx:id="assessmentsButton"
                                    text="Assessments"
                                    maxWidth="Infinity"
                                    onAction="#showAssessments"
                                    styleClass="nav-button"/>
                            <Button fx:id="reportsButton"
                                    text="Reports"
                                    maxWidth="Infinity"
                                    onAction="#onReportsClicked"
                                    styleClass="nav-button"/>
                            <Button text="Settings"
                                    disable="true"
                                    maxWidth="Infinity"
                                    styleClass="nav-button"/>
                        </VBox>

                        <VBox fx:id="adminNavSection" visible="false" managed="false" spacing="4">
                            <Button text="Dashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-button"/>
                            <Button fx:id="adminReportsButton" text="Reports" maxWidth="Infinity" onAction="#onAdminReportsClicked" styleClass="nav-button fxml-inline-014"/>
                            <Label text="SCHOOL" styleClass="sidebar-caption"/>
                            <Button text="Users" maxWidth="Infinity" onAction="#showUsers" styleClass="nav-button"/>
                            <Button text="Classes" maxWidth="Infinity" onAction="#showClasses" styleClass="nav-button"/>
                            <Button text="Subjects" maxWidth="Infinity" onAction="#showSubjects" styleClass="nav-button"/>
                            <Button text="Topics" maxWidth="Infinity" onAction="#showTopics" styleClass="nav-button"/>
                            <Button text="Students" maxWidth="Infinity" onAction="#showStudents" styleClass="nav-button"/>
                            <Button text="Teacher Assignments" maxWidth="Infinity" onAction="#showTeacherAssignments" styleClass="nav-button"/>
                            <Label text="SYSTEM" styleClass="sidebar-caption"/>
                            <Button text="Settings" maxWidth="Infinity" onAction="#showSettings" styleClass="nav-button"/>
                            <Button text="Audit Log" maxWidth="Infinity" onAction="#showAuditLog" styleClass="nav-button"/>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Profile menu stays visible at the bottom of the sidebar. -->
            <MenuButton fx:id="profileMenuButton"
                        mnemonicParsing="false"
                        maxWidth="Infinity"
                        styleClass="sidebar-profile-menu">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label fx:id="sidebarInitialsLabel"
                               text="SA"
                               styleClass="avatar-circle"/>
                        <VBox spacing="2">
                            <Label fx:id="sidebarUserNameLabel"
                                   text="System Administrator"
                                   styleClass="sidebar-user-name"/>
                            <Label fx:id="sidebarUserRoleLabel"
                                   text="Administrator"
                                   styleClass="sidebar-user-role"/>
                        </VBox>
                    </HBox>
                </graphic>
                <items>
                    <MenuItem text="My Profile" onAction="#showMyProfile"/>
                    <MenuItem text="Account Settings" onAction="#showAccountSettings"/>
                    <MenuItem text="Logout" onAction="#handleLogout"/>
                </items>
            </MenuButton>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea"
                   minWidth="0"
                   minHeight="0"
                   styleClass="content-area">

            <padding>
                <Insets top="28" right="28" bottom="28" left="28"/>
            </padding>

        </StackPane>
    </center>

</BorderPane>
