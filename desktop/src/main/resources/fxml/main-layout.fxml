<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.musomi.desktop.controller.MainLayoutController"
             styleClass="fxml-inline-006">

    <!-- ===================================================== -->
    <!-- TOP BAR                                               -->
    <!-- ===================================================== -->

    <top>
        <HBox prefHeight="56.0"
              alignment="CENTER_LEFT"
              spacing="16"
               styleClass="fxml-inline-007">

            <padding>
                <Insets left="20" right="20"/>
            </padding>

            <Label text="MUSOMI MANAGER"
                    styleClass="fxml-inline-008"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="roleLabel" text="Teacher"
                    styleClass="fxml-inline-009"/>

            <Label fx:id="userNameLabel" text="John"
                    styleClass="fxml-inline-010"/>

        </HBox>
    </top>


    <!-- ===================================================== -->
    <!-- LEFT SIDEBAR                                          -->
    <!-- ===================================================== -->

    <left>
        <VBox prefWidth="240.0"
              spacing="4"
               styleClass="fxml-inline-011">

            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>


            <!-- ROLE -->
            <Label fx:id="sectionRoleLabel" text="TEACHER"
                    styleClass="fxml-inline-012"/>


            <!-- ================================================= -->
            <!-- TEACHER NAVIGATION                                -->
            <!-- ================================================= -->

            <VBox fx:id="teacherNavSection"
                  spacing="4">

                <!-- DASHBOARD -->
                <Button fx:id="dashboardButton"
                        text="Dashboard"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showDashboard"
                         styleClass="fxml-inline-013"/>


                <!-- MARK ENTRY -->
                <Button fx:id="markEntryButton"
                        text="Mark Entry"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showMarkEntry"
                         styleClass="fxml-inline-014"/>


                <!-- MY CLASSES -->
                <Button fx:id="myClassesButton"
                        text="My Classes"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showMyClasses"
                         styleClass="fxml-inline-014"/>


                <!-- ASSESSMENTS -->
                <Button fx:id="assessmentsButton"
                        text="Assessments"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showAssessments"
                         styleClass="fxml-inline-014"/>


                <!-- REPORTS -->
                <Button fx:id="reportsButton"
                        text="Reports"
                        maxWidth="1.7976931348623157E308"
                        onAction="#onReportsClicked"
                         styleClass="fxml-inline-014"/>


                <!-- SETTINGS -->
                <Button text="Settings"
                        disable="true"
                        maxWidth="1.7976931348623157E308"
                         styleClass="fxml-inline-014"/>

            </VBox>


            <!-- ================================================= -->
            <!-- ADMIN NAVIGATION                                  -->
            <!-- ================================================= -->

            <VBox fx:id="adminNavSection"
                  visible="false"
                  managed="false"
                  spacing="4">

                <Label text="ADMIN"
                        styleClass="fxml-inline-015"/>

                <Button text="Dashboard"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showDashboard"/>

                <Button fx:id="adminReportsButton"
                        text="Reports"
                        maxWidth="1.7976931348623157E308"
                        onAction="#onAdminReportsClicked"
                        styleClass="fxml-inline-014"/>

                <Button text="Users"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showUsers"/>

                <Button text="Classes"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showClasses"/>

                <Button text="Subjects"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showSubjects"/>

                <Button text="Topics"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showTopics"/>

                <Button text="Students"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showStudents"/>

                <Button text="Teacher Assignments"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showTeacherAssignments"/>

                <Button text="Settings"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showSettings"/>

                <Button text="Audit Log"
                        maxWidth="1.7976931348623157E308"
                        onAction="#showAuditLog"/>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

        </VBox>
    </left>


    <!-- ===================================================== -->
    <!-- MAIN CONTENT AREA                                     -->
    <!-- ===================================================== -->

    <center>
        <StackPane fx:id="contentArea"
                   minWidth="0"
                   minHeight="0"
                    styleClass="fxml-inline-006">

            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

        </StackPane>
    </center>

</BorderPane>
