<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.musomi.desktop.controller.MainLayoutController"
            prefWidth="1200.0"
            prefHeight="700.0"
            styleClass="main-layout">

    <!-- Top bar -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20.0"
              styleClass="topbar"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="12.0" right="20.0"
                        bottom="12.0" left="20.0"/>
            </padding>

            <Label text="MUSOMI MANAGER"
                   styleClass="brand-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="globalSearchField"
                       promptText="Search..."
                       prefWidth="260.0"
                       styleClass="global-search"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    styleClass="nav-button"/>
        </HBox>
    </top>

    <!-- Sidebar and page content -->
    <center>
        <HBox spacing="0.0">

            <!-- Sidebar -->
            <VBox prefWidth="240.0"
                  spacing="8.0"
                  styleClass="sidebar">

                <padding>
                    <Insets top="20.0" right="12.0"
                            bottom="20.0" left="12.0"/>
                </padding>

                <Label text="NAVIGATION"
                       styleClass="sidebar-title"/>

                <Button fx:id="dashboardNavButton"
                        text="Dashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"
                        onAction="#showDashboard"/>

                <!-- Admin navigation -->
                <VBox fx:id="adminNavSection" spacing="8.0">
                    <Label text="ADMIN"
                           styleClass="sidebar-title"/>

                    <Button fx:id="usersNavButton"
                            text="Users"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showUsers"/>

                    <Button fx:id="classesNavButton"
                            text="Classes"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showClasses"/>

                    <Button fx:id="subjectsNavButton"
                            text="Subjects"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showSubjects"/>

                    <Button text="Teacher Assignments"
                            maxWidth="Infinity"
                            onAction="#showTeacherAssignments"/>

                    <Button fx:id="topicsNavButton"
                            text="Topics"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showTopics"/>

                    <Button fx:id="studentsNavButton"
                            text="Students"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showStudents"/>

                    <Region prefHeight="15.0"/>

                    <Label text="SYSTEM"
                           styleClass="sidebar-title"/>

                    <Button fx:id="settingsNavButton"
                            text="Settings"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showSettings"/>

                    <Button fx:id="auditLogNavButton"
                            text="Audit Log"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showAuditLog"/>
                </VBox>

                <!-- Teacher navigation -->
                <VBox fx:id="teacherNavSection" spacing="8.0">
                    <Label text="TEACHER"
                           styleClass="sidebar-title"/>

                    <Button fx:id="myClassesNavButton"
                            text="My Classes"
                            maxWidth="Infinity"
                            styleClass="nav-button"
                            onAction="#showMyClasses"/>
                </VBox>

            </VBox>

            <!-- Main page content -->
            <StackPane fx:id="contentArea"
                       HBox.hgrow="ALWAYS"
                       styleClass="content-area"/>
        </HBox>
    </center>

</BorderPane>
